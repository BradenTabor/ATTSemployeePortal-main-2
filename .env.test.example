# ATTS Employee Portal — E2E / test Supabase target
#
# Copy to `.env.test` (gitignored). Playwright, `npm run test:setup`, and the
# service-role E2E helper load this file AHEAD of `.env`, and Vite is started with
# `--mode test` so the app under test resolves the same project.
#
# The suite REFUSES to run against the production project (emqqxfzahmwnehxcpxzp)
# — it seeds @atts.test accounts and fake safety submissions. Point it at one of:
#
#   A) Local Supabase (free, recommended):
#        npx supabase start          # prints URL + keys; the defaults below match
#        npx supabase db reset       # applies supabase/migrations + seed
#   B) A dedicated Supabase test project (Dashboard → New project), then paste its
#      URL / anon / service-role keys here.
#
# Then: npm run test:setup && npm run test:e2e

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: silence third-party integrations during tests
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_MAKE_DVIR_WEBHOOK_URL=
# VITE_MAKE_RTO_WEBHOOK_URL=
# VITE_MAKE_DEN_WEBHOOK_URL=

# Escape hatch — ONLY if you truly must run E2E against prod. Clean up after:
#   npm run test:cleanup-db
# E2E_ALLOW_PROD=I_UNDERSTAND_THIS_WRITES_TEST_DATA_TO_PROD
